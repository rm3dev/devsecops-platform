# --- Secrets: NEVER commit (gitleaks pre-commit hook also enforces) ---
.env
secrets/
*.pem
*.key
*.p12
*.pfx
reverse-proxy/certificates/*.crt
reverse-proxy/certificates/*.key
reverse-proxy/certificates/*.srl
!reverse-proxy/certificates/.gitkeep
# Generated by bootstrap.sh from dynamic.yml.tmpl
reverse-proxy/configuration/dynamic/dynamic.yml
vault/**/recovery-key*
backups/

# --- Runtime data (bind-mounted under DATA_ROOT on the host, not in repo) ---
data/
jenkins-home/
nexus-data/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- Build/test scratch ---
*.log
tmp/
.cache/
jenkins/agents/common/platform-ca.crt

# local credential cache (never commit)
.secrets/
