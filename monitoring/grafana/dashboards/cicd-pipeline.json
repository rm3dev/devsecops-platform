{
 "uid": "devsecops-cicd",
 "title": "CI/CD Pipeline (Jenkins + GitLab + Nexus)",
 "tags": [
  "devsecops",
  "cicd"
 ],
 "description": "Controller/agent capacity, build throughput & durations, webhook-path health (Sidekiq), artifact repository liveness.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "timezone": "browser",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 11,
   "type": "stat",
   "title": "Build queue",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "jenkins_queue_size_value",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 12,
   "type": "stat",
   "title": "Executors in use",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "jenkins_executor_in_use_value",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 13,
   "type": "stat",
   "title": "Agents online / offline",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "jenkins_node_online_value",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "jenkins_node_offline_value",
     "legendFormat": "",
     "range": true,
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 14,
   "type": "stat",
   "title": "Builds scheduled (1h)",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "increase(jenkins_job_scheduled_total[1h])",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 15,
   "type": "stat",
   "title": "GitLab Sidekiq backlog",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "sum(sidekiq_queue_size)",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 100
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 16,
   "type": "stat",
   "title": "Nexus scrape",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "up{job=\"nexus\"}",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Jenkins: build throughput",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "rate(jenkins_job_scheduled_total[15m])",
     "legendFormat": "scheduled/s",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Jenkins: queue & executors",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "jenkins_queue_size_value",
     "legendFormat": "queue",
     "range": true,
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "jenkins_executor_in_use_value",
     "legendFormat": "in use",
     "range": true,
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "jenkins_executor_available_value",
     "legendFormat": "available",
     "range": true,
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 19,
   "type": "timeseries",
   "title": "Jenkins: running-build duration quantiles",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "jenkins_job_building_duration_seconds{quantile=~\"0.5|0.9|0.99\"}",
     "legendFormat": "p{{quantile}}",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "Summary published because prometheusConfiguration.countFinishedBuilds=true (JCasC)"
  },
  {
   "id": 20,
   "type": "timeseries",
   "title": "GitLab: Sidekiq queues (top 10)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "topk(10, sidekiq_queue_size)",
     "legendFormat": "{{queue}}",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "calcs": [
      "mean",
      "max"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 21,
   "type": "timeseries",
   "title": "GitLab: ruby process memory",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "ruby_memory_bytes",
     "legendFormat": "{{process}}",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 22,
   "type": "timeseries",
   "title": "Scrape duration per CI/CD job",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "scrape_duration_seconds{job=~\"jenkins|gitlab-exporter|nexus|vault\"}",
     "legendFormat": "{{job}}",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ],
 "annotations": {
  "list": [
   {
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "expr": "changes(process_start_time_seconds{job=~\"jenkins|gitlab-exporter|nexus|vault\"}[5m]) > 0",
    "iconColor": "blue",
    "name": "Service restarts",
    "refId": "A",
    "titleFormat": "{{job}} restarted"
   }
  ]
 }
}
