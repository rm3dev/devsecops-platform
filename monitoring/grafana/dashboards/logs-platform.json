{
 "uid": "devsecops-logs",
 "title": "Platform Logs (Loki + Alloy)",
 "tags": [
  "devsecops",
  "logs",
  "loki"
 ],
 "description": "Collection-pipeline health and cross-service error visibility. Healthcheck noise is dropped at Alloy before ingestion (D-35).",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "timezone": "browser",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 39,
   "type": "stat",
   "title": "Log ingestion rate",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "sum(rate(loki_distributor_bytes_received_total[5m]))",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 40,
   "type": "stat",
   "title": "Lines/s received",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "sum(rate(loki_distributor_lines_received_total[5m]))",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 41,
   "type": "stat",
   "title": "Alloy collector",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "up{job=\"alloy\"}",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 42,
   "type": "stat",
   "title": "Loki",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "up{job=\"loki\"}",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 43,
   "type": "timeseries",
   "title": "Log volume by service",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (service) (count_over_time({project=~\".+\"}[$__interval]))",
     "legendFormat": "{{service}}",
     "range": true,
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "calcs": [
      "mean",
      "max"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 44,
   "type": "timeseries",
   "title": "Error/fatal/panic line rate by service",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (service) (rate({project=~\".+\"} |~ `(?i)\\\\b(error|fatal|panic)\\\\b`[5m]))",
     "legendFormat": "{{service}}",
     "range": true,
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "calcs": [
      "mean",
      "max"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "Same expression family as the ContainerErrorLogSpike ruler alert (monitoring/loki/rules/fake/platform-logs.yml)"
  },
  {
   "id": 45,
   "type": "logs",
   "title": "Live error stream (whole platform)",
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 12
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{project=~\".+\"} |~ `(?i)\\\\b(error|fatal|panic)\\\\b`",
     "queryType": "range",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "showLabels": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  }
 ],
 "annotations": {
  "list": [
   {
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "expr": "changes(process_start_time_seconds{job=~\"jenkins|gitlab-exporter|nexus|vault\"}[5m]) > 0",
    "iconColor": "blue",
    "name": "Service restarts",
    "refId": "A",
    "titleFormat": "{{job}} restarted"
   }
  ]
 }
}
