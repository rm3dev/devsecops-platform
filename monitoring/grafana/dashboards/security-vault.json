{
 "uid": "devsecops-security",
 "title": "Security & Vault",
 "tags": [
  "devsecops",
  "security",
  "vault"
 ],
 "description": "Secrets-plane health (Vault seal/leases), auth-failure log signals, edge anomaly rates. Loki datasource used for log-derived panels.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "timezone": "browser",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 31,
   "type": "stat",
   "title": "Vault seal state",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "vault_core_unsealed",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "description": "0 = SEALED (VaultSealed alert is critical: ESO + cosign + pipelines all depend on Vault)"
  },
  {
   "id": 32,
   "type": "stat",
   "title": "Vault leases",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "vault_expire_num_leases",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 5000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 33,
   "type": "timeseries",
   "title": "Vault runtime memory",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "vault_runtime_alloc_bytes",
     "legendFormat": "alloc",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 34,
   "type": "timeseries",
   "title": "Vault lease trend",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "vault_expire_num_leases",
     "legendFormat": "leases",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 35,
   "type": "timeseries",
   "title": "Traefik 4xx/5xx rates (anomaly surface)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "sum(rate(traefik_service_requests_total{code=~\"4..\"}[5m]))",
     "legendFormat": "4xx/s",
     "range": true,
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "sum(rate(traefik_service_requests_total{code=~\"5..\"}[5m]))",
     "legendFormat": "5xx/s",
     "range": true,
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 36,
   "type": "timeseries",
   "title": "Auth-relevant log lines (Vault + GitLab + Jenkins)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (service) (rate({service=~\"vault|gitlab|jenkins\"} |~ `(?i)(authentication failed|invalid token|access denied|unauthorized)`[5m]))",
     "legendFormat": "{{service}}",
     "range": true,
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 37,
   "type": "logs",
   "title": "Vault log tail (error|warn|seal)",
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service=\"vault\"} |~ `(?i)(error|warn|seal)`",
     "queryType": "range",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "showLabels": false,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  },
  {
   "id": 38,
   "type": "text",
   "title": "Pipeline security artifacts",
   "gridPos": {
    "h": 3,
    "w": 24,
    "x": 0,
    "y": 22
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "mode": "markdown",
    "content": "**Gate evidence is NOT metric data** \u2014 Trivy/Semgrep/Gitleaks/SBOM/cosign reports live as Jenkins build artifacts (`reports/**`) and SonarQube quality gates. This dashboard covers the *secrets infrastructure*; see `documentation/security.md` \u00a76 and the per-build **Security summary** notification field for gate outcomes."
   }
  }
 ],
 "annotations": {
  "list": [
   {
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "expr": "changes(process_start_time_seconds{job=~\"jenkins|gitlab-exporter|nexus|vault\"}[5m]) > 0",
    "iconColor": "blue",
    "name": "Service restarts",
    "refId": "A",
    "titleFormat": "{{job}} restarted"
   }
  ]
 }
}
